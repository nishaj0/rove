# Node
app/node_modules/
app/dist/

# Tauri/Rust
app/src-tauri/target/
app/src-tauri/gen/
app/src-tauri/resources/backend/*.exe
app/src-tauri/resources/backend/cloud-saver-daemon
!app/src-tauri/resources/backend/.gitkeep

# Go
backend/*.exe
backend/*.test
backend/coverage.out

# IDE
.vscode/

# OAuth credential downloads contain private client secrets. Cloud Saver only
# uses the public installed-app client ID and PKCE; never commit these files.
client_secret_*.json
google-oauth-client*.json
