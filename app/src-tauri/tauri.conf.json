{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rove",
  "version": "0.1.0",
  "identifier": "com.cloudsaver.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "resources": [
      "resources/backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNEFBM0Q0MzdCMDZCQjYKUldTMmE3QTMxS05LNFd1STZ0Q3dzdkxkN1pFa0NKdi9FMDRYVG1CU1gyRGo4SlRkQnR4Ni9semwK",
      "endpoints": [
        "https://github.com/nishaj0/game-cloud-saver/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Rove",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  }
}
