{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud Saver",
  "version": "0.1.0",
  "identifier": "com.cloudsaver.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "resources": [
      "resources/backend"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Cloud Saver",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  }
}
